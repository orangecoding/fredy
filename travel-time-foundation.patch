+/*
+ * Travel time map visualization layer foundation.
+ *
+ * This component will later render isochrone polygons
+ * on top of the existing Fredy map layer.
+ */
+
+export default function TravelTimeLayer({
+  enabled = false,
+  area = null,
+}) {
+  if (!enabled || !area) {
+    return null;
+  }
+
+  return null;
+}
+
