+/*
+ * Travel time filter UI foundation.
+ */
+
+import { Select } from '@douyinfe/semi-ui-19';
+
+export default function TravelTimeFilter({
+  value,
+  onChange,
+}) {
+  return (
+    <Select
+      value={value}
+      onChange={onChange}
+      optionList={[
+        {
+          label: 'Public transport',
+          value: 'public_transport',
+        },
+        {
+          label: 'Car',
+          value: 'car',
+        },
+      ]}
+    />
+  );
+}
+
